# Discord Bot
DISCORD_TOKEN=your-discord-token-here

# SQL Database (dev uses docker-compose override; prod needs this set)
DATABASE_URL=postgresql://user:password@hostname:5432/bot_db

# MongoDB (requires a replica set or Atlas cluster for change streams)
# Database name is taken from the URI path (e.g. /bot_db below)
MONGODB_URI=mongodb://user:password@hostname:27017/bot_db

# Optional. Set to a server ID to register slash commands against that server
# only, which Discord applies immediately instead of taking up to an hour to
# propagate a global change. Useful while deploying repeatedly.
#
# Single-server only: global commands are removed while this is set, so any
# other server the bot is in loses its commands until you unset it.
# DISCORD_GUILD_ID=
